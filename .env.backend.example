# Backend environment variables — copy to .env.backend and fill in real values
# NEVER commit .env.backend to version control

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=oslt_user
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=oslt_db

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=production

# ── Security — generate all three with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-64-hex-char-string
JWT_SECRET_KEY=replace-with-a-different-random-64-hex-char-string
ADMIN_SECRET=replace-with-a-secure-admin-passphrase

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://your-frontend-domain.com
