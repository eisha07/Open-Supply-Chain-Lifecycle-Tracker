# ── Open Supply-Chain Lifecycle Tracker — environment template ─────────────────
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env          (macOS / Linux)
#     Copy-Item .env.example .env   (Windows PowerShell)
#
# `.env` is git-ignored. Docker Compose reads it automatically for ${VAR}
# substitution. Variables marked REQUIRED have no fallback — the stack refuses to
# start without them rather than booting with a publicly-known secret.
#
# Generate a secret:   openssl rand -hex 32
# On Windows:          $b=New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); ($b|%{$_.ToString("x2")}) -join ""

# ── Database ───────────────────────────────────────────────────────────────────
POSTGRES_USER=oslt_user
POSTGRES_DB=oslt_db
# REQUIRED. Note: PostgreSQL only reads this on first initialisation of an empty
# data directory — changing it later has no effect on an existing volume.
POSTGRES_PASSWORD=change-me-generate-a-strong-password

# ── Application ────────────────────────────────────────────────────────────────
# Leave this commented out unless you have a specific reason to override it.
# The mode is chosen by which compose file you invoke: docker-compose.override.yml
# forces `development`, the base docker-compose.yml defaults to `production`.
#   development = backend auto-creates tables on boot (convenient locally)
#   production  = Alembic owns the schema; migrations run via entrypoint.sh
# APP_ENV=production

# ── Secrets — REQUIRED ─────────────────────────────────────────────────────────
# Never reuse the values from a development environment in production.
SECRET_KEY=
JWT_SECRET_KEY=
ADMIN_SECRET=

# ── API key for HMAC request signing ───────────────────────────────────────────
# Empty = read endpoints (twins, events, passport) are unauthenticated.
# Set this in production.
API_KEY=
API_KEY_HEADER=X-API-Key
# Max accepted age of a signed request, in seconds (replay protection).
API_KEY_MAX_AGE_SECONDS=300

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── Signature replay window (seconds) ──────────────────────────────────────────
SIGNATURE_MAX_AGE_SECONDS=300

# ── Frontend ───────────────────────────────────────────────────────────────────
# Compiled into the browser bundle at BUILD time. It must be the URL a user's
# browser can reach — not an internal Docker hostname and not localhost.
#   Single-host nginx deploy : https://your-domain.com/api
#   Backend on its own host  : https://api.your-domain.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── CORS ───────────────────────────────────────────────────────────────────────
# Must be a JSON array of origins. Add every origin that will call the API
# directly. If you serve both apps behind one nginx origin, this is only needed
# for the Swagger UI.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ── Redis ──────────────────────────────────────────────────────────────────────
# Inside Docker Compose the service is reachable as `redis`. For a managed Redis
# (Railway, Upstash, ElastiCache) use the full connection URL, e.g.
#   rediss://default:password@your-host:6379
REDIS_URL=redis://redis:6379/0
