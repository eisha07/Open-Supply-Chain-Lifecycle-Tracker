# ── PostgreSQL ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://oslt_user:oslt_pass@localhost:5432/oslt_db
# Sync URL for Alembic migrations only
SYNC_DATABASE_URL=postgresql://oslt_user:oslt_pass@localhost:5432/oslt_db

# ── Application ─────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-secret-key-never-commit-this
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Rate Limiting ────────────────────────────────────────────────────────────────
TELEMETRY_RATE_LIMIT_PER_MINUTE=120
GLOBAL_RATE_LIMIT_PER_MINUTE=600

# ── DID / Crypto ─────────────────────────────────────────────────────────────────
# Replay-attack window: max age of a signed request in seconds
SIGNATURE_MAX_AGE_SECONDS=300

# ── JWT / Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-long-random-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── Admin ──────────────────────────────────────────────────────────────────────
# Shared secret for admin operations (blacklist, serial management)
ADMIN_SECRET=change-me-to-a-strong-admin-secret

# ── API Key (HMAC request signing) ────────────────────────────────────────────
# Shared API key for read-endpoint auth.  Empty = disabled (JWT only).
# Generate with: openssl rand -hex 32
API_KEY=
API_KEY_HEADER=X-API-Key
API_KEY_MAX_AGE_SECONDS=300

# ── Redis (rate limiter backend) ─────────────────────────────────────────────
# Empty = fall back to in-memory rate limiter
REDIS_URL=
