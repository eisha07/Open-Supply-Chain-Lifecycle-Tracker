# ── Backend environment template ───────────────────────────────────────────────
#
# For running the backend OUTSIDE Docker (e.g. `uvicorn app.main:app --reload`).
# When running via Docker Compose the root `.env` is used instead, and the
# database/Redis hosts are the compose service names (`db`, `redis`).
#
# Copy to `.env` inside this directory and fill in real values.

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://oslt_user:oslt_pass@localhost:5432/oslt_db
# Sync URL used only by Alembic migrations
SYNC_DATABASE_URL=postgresql://oslt_user:oslt_pass@localhost:5432/oslt_db

# ── Application ────────────────────────────────────────────────────────────────
APP_ENV=development

# ── Secrets — REQUIRED ─────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-secret-key
JWT_SECRET_KEY=change-me-to-a-long-random-jwt-secret
ADMIN_SECRET=change-me-to-a-strong-admin-secret

# ── CORS ───────────────────────────────────────────────────────────────────────
# Must be a JSON array. A bare comma-separated string will fail to parse.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ── Rate Limiting ──────────────────────────────────────────────────────────────
TELEMETRY_RATE_LIMIT_PER_MINUTE=120
GLOBAL_RATE_LIMIT_PER_MINUTE=600

# ── DID / Crypto ───────────────────────────────────────────────────────────────
# Replay-attack window: max age of a signed request in seconds
SIGNATURE_MAX_AGE_SECONDS=300

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── Admin ──────────────────────────────────────────────────────────────────────
# Shared secret for admin operations (blacklist, serial management)
ADMIN_SECRET=change-me-to-a-strong-admin-secret

# ── API Key (HMAC request signing) ─────────────────────────────────────────────
# Shared key for read-endpoint auth. Empty = disabled (JWT only).
# Generate with: openssl rand -hex 32
API_KEY=
API_KEY_HEADER=X-API-Key
API_KEY_MAX_AGE_SECONDS=300

# ── Redis (cache + rate limiter) ───────────────────────────────────────────────
# Empty = fall back to in-memory rate limiter and disable caching
REDIS_URL=redis://localhost:6379/0
